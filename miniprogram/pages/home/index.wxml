<view class="page">
  <view class="topline"><view class="brand"><text class="brand-mark">rp</text>RESEARCHPILOT</view><text wx:if="{{demo}}" class="demo-chip">离线演示 · 虚构数据</text></view>
  <view class="title">研究工作台</view><view class="subtitle">研究进度、报告与来源，集中查看。</view>
  <view class="composer"><view class="composer-label">开始一项研究</view><button class="compose-trigger" bindtap="newResearch"><text>今天想研究什么？</text><text class="compose-plus">＋</text></button><view class="quick-topics"><text class="chip" data-topic="研究一家公司的现金流质量" bindtap="quick">现金流质量</text><text class="chip" data-topic="梳理产业链需求变化与反面证据" bindtap="quick">产业链变化</text></view></view>
  <view class="stats"><view class="stat"><view class="number">{{me.history_count || 0}}</view><view class="muted">研究记录</view></view><view class="stat"><view class="number">{{me.watch_count || 0}}</view><view class="muted">自选公司</view></view><view class="stat"><view class="number">{{me.daily_used || 0}}<text class="muted"> / {{me.daily_limit || 5}}</text></view><view class="muted">今日研究</view></view></view>
  <view class="row section"><text>最近研究 <text class="muted">{{total}}</text></text><button class="link" bindtap="load">刷新</button></view>
  <view class="search-field"><text>⌕</text><input value="{{query}}" bindinput="search" placeholder="搜索当前列表" /></view>
  <view class="filters"><view class="filter {{filter==='all'?'active':''}}" data-filter="all" bindtap="selectFilter">全部</view><view class="filter {{filter==='active'?'active':''}}" data-filter="active" bindtap="selectFilter">进行中</view><view class="filter {{filter==='completed'?'active':''}}" data-filter="completed" bindtap="selectFilter">已完成</view></view>
  <view wx:if="{{error && !creating}}" class="error">{{error}}</view><view wx:if="{{busy && !runs.length}}" class="loading">正在读取研究记录…</view>
  <view wx:if="{{visibleRuns.length}}" class="research-list"><view wx:for="{{visibleRuns}}" wx:key="id" class="research-row" data-id="{{item.id}}" bindtap="open"><view class="document-icon">▤</view><view class="grow"><view class="card-title">{{item.topic}}</view><view class="meta"><text class="status">● {{item.status}}</text> · {{item.time}}</view><view class="meta">{{item.versions.length}} 个版本 · 搜索 {{item.searches}}/{{item.budget}}</view></view><text class="chevron">›</text></view></view>
  <view wx:if="{{!busy && !visibleRuns.length && !error}}" class="empty">{{runs.length?'没有匹配的研究，换个关键词或筛选条件。':'还没有研究记录，先写下想核查的问题。'}}</view>
  <view class="list-caption">已加载 {{runs.length}} / {{total}} 项</view><button wx:if="{{total > runs.length}}" bindtap="more" loading="{{busy}}" disabled="{{busy}}">加载更多研究</button><view class="note">离开页面后，服务器仍可继续研究。报告应与原始证据一起阅读。</view>
</view>
<view wx:if="{{creating}}" class="sheet-mask" bindtap="close" catchtouchmove="stop"><view class="sheet" catchtap="stop"><view class="sheet-handle"></view><view class="row"><view class="section">新建研究</view><button class="sheet-close" bindtap="close">×</button></view><view class="subtitle">写清研究对象与想核查的问题，报告会保留资料来源。</view><label class="label">你希望核查什么？</label><textarea value="{{topic}}" bindinput="topic" maxlength="1200" placeholder="例如：收入增长是否转化为经营现金流？" /><view class="quick-topics"><text class="chip" data-topic="研究一家公司的现金流质量" bindtap="template">现金流质量</text><text class="chip" data-topic="梳理产业链需求变化与反面证据" bindtap="template">产业链变化</text></view><label class="label">搜索次数上限</label><picker range="{{budgets}}" bindchange="budget"><view class="picker">{{budget}} 次</view></picker><view wx:if="{{error}}" class="error">{{error}}</view><view class="actions"><button class="primary wide" bindtap="submit" loading="{{submitting}}" disabled="{{submitting || !topic}}">{{demo?'生成离线演示报告':'开始研究'}} ↗</button></view><view class="note">{{demo?'此入口只生成虚构报告，不消耗模型费用。':'研究在后台执行，次数与并发受账号配额限制。'}}</view></view></view>

<view class="page {{largeText?'reading-large':''}}">
  <view class="row"><text class="eyebrow">研究详情</text><text wx:if="{{demo}}" class="demo-chip">离线演示 · 虚构数据</text></view>
  <view class="report-title">{{run.topic || '正在读取研究'}}</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="link" bindtap="load">重试</button></view>
  <view wx:if="{{run}}">
    <view class="row detail-summary"><view><text class="status">● {{run.status}}</text><view class="meta">{{run.time}} · 北京时间</view></view><text class="pill">搜索 {{run.searches}}/{{run.budget}}</text></view>
    <view wx:if="{{!demo && !run.completed}}" class="actions"><button data-kind="{{run.active?'pause':'resume'}}" bindtap="command" loading="{{busy}}" disabled="{{busy}}">{{run.active?'暂停研究':'恢复研究'}}</button></view><view wx:if="{{run.error}}" class="error">{{run.error}}</view>
    <view class="tabs"><view class="tab {{tab==='report'?'active':''}}" data-tab="report" bindtap="tab">报告</view><view class="tab {{tab==='sources'?'active':''}}" data-tab="sources" bindtap="tab">证据 {{report.cards.length || 0}}</view><view class="tab {{tab==='process'?'active':''}}" data-tab="process" bindtap="tab">过程</view></view>
    <view wx:if="{{versions.length && tab!=='process'}}" class="reading-toolbar"><picker range="{{versions}}" range-key="label" value="{{versionIndex}}" bindchange="version"><view class="picker">{{versions[versionIndex].label}} ▾</view></picker><button wx:if="{{tab==='report'}}" class="icon-button" bindtap="outline">☷</button><button wx:if="{{tab==='report'}}" class="icon-button {{largeText?'selected':''}}" bindtap="reading">T</button></view>
    <view wx:if="{{tab==='report' && report}}" class="report">
      <view wx:for="{{report.sections}}" wx:key="sectionIndex" wx:for-item="section" class="report-section" id="report-section-{{section.sectionIndex}}"><view class="report-heading">{{section.title}}</view><view wx:for="{{section.blocks}}" wx:key="id" wx:for-item="block" class="md-block md-{{block.kind}}"><rich-text nodes="{{block.nodes}}" user-select /></view><button wx:for="{{section.citations}}" wx:key="*this" wx:for-item="eid" class="citation-chip" data-eid="{{eid}}" bindtap="citation">查看 {{eid}} ↗</button></view>
      <view class="note lined">此版本的引用对应保存的来源，文本匹配不代表独立事实认证。<view class="version">版本 {{report.id}}</view></view>
    </view>
    <view wx:if="{{tab==='report' && !report}}" class="empty">报告尚未生成，可先查看研究过程。</view>
    <view wx:if="{{tab==='sources' && report}}"><view wx:for="{{report.cards}}" wx:key="eid" id="source-{{item.eid}}" class="source-card {{sourceFocus===item.eid?'selected':''}}"><view class="row"><text class="badge">{{item.eid}}</text><text class="muted">{{item.date || '来源日期未知'}}</text></view><view class="card-title" style="margin-top:22rpx">{{item.title}}</view><view class="meta">{{demo?'虚构演示资料':'已保留来源日期依据'}} · {{item.read_status==='success'?'已保存文本':'原文状态待核对'}}</view><view wx:for="{{item.excerpts}}" wx:key="*this" wx:for-item="excerpt" class="source-quote"><text selectable>{{excerpt}}</text></view><view class="meta">{{item.excerpt_kind}}</view><button class="link" data-url="{{item.url}}" bindtap="source">复制原始来源链接 ↗</button></view><view wx:if="{{!report.cards.length}}" class="empty">此版本未保存可追溯的引用资料。</view></view>
    <view wx:if="{{tab==='process'}}"><view wx:for="{{run.events}}" wx:key="position" class="timeline-item"><text class="timeline-dot">{{item.position}}</text><view class="card-title">{{item.tool}}</view><view class="meta">{{item.reason}}</view><view class="timeline-result">{{item.result}}</view></view><view wx:if="{{run.gaps.length}}" class="section">仍需核查</view><view wx:for="{{run.gaps}}" wx:key="issue" class="card"><view>{{item.issue}}</view><view class="meta">{{item.next}}</view></view><view class="note">这里只显示行动摘要，用量或费用缺失时不作估计。</view></view>
  </view>
</view>
<view wx:if="{{outlineOpen}}" class="sheet-mask" bindtap="closeOutline" catchtouchmove="stop"><view class="sheet" catchtap="stop"><view class="sheet-handle"></view><view class="row"><view class="section">报告目录</view><button class="sheet-close" bindtap="closeOutline">×</button></view><button wx:for="{{report.sections}}" wx:key="sectionIndex" class="directory-row" data-index="{{item.sectionIndex}}" bindtap="section"><text class="code">{{index+1}}</text>{{item.title}}</button></view></view>

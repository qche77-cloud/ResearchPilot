<view class="page">
  <view class="row"><text class="eyebrow">公司研究</text><text wx:if="{{demo}}" class="demo-chip">离线演示 · 虚构数据</text></view>
  <view class="company-heading"><view class="company-avatar">研</view><view><view class="title">{{name}}</view><view class="code">{{company.symbol}} · 自选公司资料</view></view></view>
  <button class="primary wide" bindtap="research" loading="{{busy}}" disabled="{{busy}}">研究这家公司 ↗</button><view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{company}}">
    <view class="row section"><text>已保存财务</text><text class="muted">{{company.analysis.usable_records}} 条可用</text></view>
    <view wx:if="{{periods.length}}" class="finance-controls"><picker range="{{periods}}" value="{{periodIndex}}" bindchange="period"><view class="picker">{{selectedPeriod}} ▾</view></picker><picker range="{{groups}}" range-key="label" value="{{scopeIndex}}" bindchange="scope"><view class="picker">{{groups[scopeIndex].label}} ▾</view></picker></view>
    <view class="metric-grid"><button wx:for="{{metricCards}}" wx:key="id" class="metric-card" data-id="{{item.id}}" bindtap="inspect"><view class="metric-label">{{item.label}}</view><view class="metric-value">{{item.display_value}}</view><view class="metric-unit">{{item.currency}} {{item.display_unit}} · 查看来源 ↗</view></button></view>
    <view wx:if="{{trend.length}}" class="card"><view class="card-title">营业收入</view><view class="meta">{{trendLabel}} · 点选查看来源</view><button wx:for="{{trend}}" wx:key="record_id" class="trend-row" data-id="{{item.record_id}}" bindtap="inspect"><view class="row"><text class="code">{{item.period}}</text><text class="metric-value" style="font-size:25rpx">{{item.display_value}}</text></view><view class="bar" style="width:{{item.width}}%"></view></button></view>
    <view wx:if="{{records.length}}" class="section">本期原始记录</view><view class="finance-list"><button wx:for="{{records}}" wx:key="id" class="finance-row" data-id="{{item.id}}" bindtap="inspect"><view><view>{{item.label}}</view><view class="meta">{{item.currency}} · {{item.display_unit}}</view></view><text class="metric-value">{{item.display_value}}</text></button></view>
    <view wx:if="{{!records.length}}" class="empty">还没有校验通过的财务记录，单位或口径缺失时保留缺口。</view><view class="note">图表只展示同口径源值，不作财务推断。{{demo?'所有数字均为虚构，不代表同代码真实公司。':''}}当前移动端没有桌面自动同步或财报上传。</view><view class="note lined">版本 {{company.dataset_id || '未保存'}}<view>保存时间 {{company.saved_at || '未知'}}</view></view>
  </view>
</view>
<view wx:if="{{inspected}}" class="sheet-mask" bindtap="close" catchtouchmove="stop"><view class="sheet" catchtap="stop"><view class="sheet-handle"></view><view class="row"><view class="section">{{inspected.label}}</view><button class="sheet-close" bindtap="close">×</button></view><view class="record-value">{{inspected.display_value}}</view><view class="muted">{{inspected.currency}} {{inspected.display_unit}} · 标准值</view><view class="record-row"><text class="muted">财报期</text><text class="value">{{inspected.period_end}}</text></view><view class="record-row"><text class="muted">比较口径</text><text class="value">{{inspected.basisLabel}}</text></view><view class="record-row"><text class="muted">报表范围</text><text class="value">{{inspected.scopeLabel}}</text></view><view class="record-row"><text class="muted">源值与单位</text><text class="value">{{inspected.raw_value}} {{inspected.raw_unit}}</text></view><view class="record-row"><text class="muted">来源披露</text><text class="value">{{inspected.published_at || '未知'}}</text></view><view class="record-row"><text class="muted">采集时间</text><text class="value">{{inspected.fetchedLabel}}</text></view><view class="record-row"><text class="muted">记录编号</text><text class="value code">{{inspected.id}}</text></view><button class="link" data-url="{{inspected.source_url}}" bindtap="source">复制原始来源链接 ↗</button><view class="note">{{demo?'此处为虚构演示记录。':'对照财报期、单位与报表口径后再使用数据。'}}</view></view></view>
